# Flask
JWT_SECRET_KEY=change-this-to-a-strong-secret-in-production
MONGO_URI=mongodb://localhost:27017/heart_prediction
FLASK_ENV=development

# Pagination defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Critical risk threshold (%)
CRITICAL_RISK_THRESHOLD=70

# Email (optional - PDF reports sent after prediction)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=HeartAI <your-email@gmail.com>
